---
import Base from "@/layouts/Base.astro";
import { getListPage, getSinglePage } from "@/lib/contentParser.astro";
import {
  getLangFromUrl,
  slugSelector,
  supportedLang,
} from "@/lib/utils/languageParser";
import Testimonial from "@/partials/Testimonial.astro";
import AboutUs from "@/partials/homepage/AboutUs.astro";
import BannerFeature from "@/partials/homepage/BannerFeature.astro";
import Feature from "@/partials/homepage/Feature.astro";
import Locations from "@/partials/homepage/Locations.astro";
import FunFacts from "@/partials/homepage/FunFacts.astro";
import HeroSlider from "@/partials/homepage/HeroSlider.astro";
import LatestNews from "@/partials/homepage/LatestNews.astro";
import ServiceSection from "@/partials/homepage/ServiceSection.astro";
import FAQSection from "@/components/FAQSection.astro";
import { render } from "astro:content";
// import Team from "@/partials/homepage/Team.astro";

export function getStaticPaths() {
  const paths = supportedLang.map((lang) => ({
    params: { lang: lang || undefined },
  }));
  return paths;
}

const { lang } = Astro.params;
const homepage = await getListPage("homepage", lang as string);

const {
  hero_slider,
  banner_feature,
  funfacts,
  feature,
  latest_news,
  faq_section,
} = homepage[0].data;
const { Content: HomeContent } = await render(homepage[0]);

const aboutIndex = await getListPage("about", lang as string);
const serviceIndex = await getListPage("services", lang as string);
const services = await getSinglePage("services", lang as string);
const allLocations = await getSinglePage("locations", lang as string);
const featuredSlugs = [
  "manchester",
  "liverpool",
  "preston",
  "blackpool",
  "bolton",
  "blackburn",
];
const locations = allLocations.filter((loc) => {
  const slug = loc.id.split("/").pop();
  return featuredSlugs.includes(slug || "");
});
const otherLocations = allLocations.filter((loc) => {
  const slug = loc.id.split("/").pop();
  return !featuredSlugs.includes(slug || "");
});
const posts = await getSinglePage("blog", lang as string);

const testimonial = await getSinglePage(
  "testimonials",
  lang as string,
  "testimonial",
);
---

<Base
  title="Fire Risk Assessments North West | Fire Safety Management Company"
  description="Our comprehensive fire risk assessments across the North West identify potential fire hazards, helping businesses & property landlords maintain compliance."
>
  <HeroSlider heroSlider={hero_slider} />
  <BannerFeature bannerFeature={banner_feature} />
  <AboutUs about={aboutIndex[0].data.about_section} />
  <FunFacts funfacts={funfacts} />
  <Feature feature={feature} />
  <ServiceSection
    serviceIndex={serviceIndex[0]}
    services={services}
    title="Fire Safety & Compliance Services"
  />
  <Locations locations={locations} otherLocations={otherLocations} />
  <Testimonial testimonial={testimonial[0].data} />
  <section class="section">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-10">
          <div class="content">
            <HomeContent />
          </div>
        </div>
      </div>
    </div>
  </section>
  <section
    class="section overlay-secondary bg-fixed bg-[url('/images/backgrounds/cta-lg.jpg')]"
  >
    <div class="container">
      <div class="row">
        <div class="lg:col-7 md:col-10 col-11 text-center mx-auto">
          <h2 class="h1 text-white relative mb-8">
            Book Your Fire Risk Assessment Today
          </h2>
          <p class="text-white/80 relative mb-4">
            If you need a fire risk assessment company North West businesses
            recommend, send us the property details — type, location, floors and
            occupancy — and we will confirm the earliest suitable slot and the
            expected reporting timescale. Urgent fire risk assessment North West
            requests, including those tied to an enforcement notice or a licence
            deadline, can often be accommodated, with 24-hour report delivery on
            request.
          </p>
          <p class="text-white/80 relative mb-12">
            One call keeps the whole picture covered: the assessment, the
            remedial work it recommends and the annual review that keeps you
            compliant year after year.
          </p>
          <a
            href={slugSelector("/contact", getLangFromUrl(Astro.url))}
            class="btn btn-primary hover-ripple relative"
          >
            Get a Quote
          </a>
        </div>
      </div>
    </div>
  </section>
  {faq_section && faq_section.enable && <FAQSection data={faq_section} />}
  <LatestNews posts={posts} latest_news={latest_news} />
</Base>
