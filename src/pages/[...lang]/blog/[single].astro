---
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { buildBlogPostingSchema } from "@/lib/schema";
import { stripHtmlExt, supportedLang } from "@/lib/utils/languageParser";
import PostSingle from "@/partials/PostSingle.astro";

export async function getStaticPaths() {
  const paths = await Promise.all(
    supportedLang.map(async (lang) => {
      const posts = await getSinglePage("blog", lang as string);

      return posts.map((post) => ({
        params: {
          lang: lang || undefined,
          single: post.id.split("/").pop(),
        },
        props: {
          post,
        },
      }));
    }),
  );
  return paths.flat();
}

const { post } = Astro.props;
const { title, meta_title, description, image, date, tags } = post.data;

const blogSchema = buildBlogPostingSchema({
  title,
  description,
  image,
  keywords: tags,
  date,
  url: `${config.site.base_url}${stripHtmlExt(Astro.url.pathname)}`,
  body: post.body ?? "",
});
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
  schema={blogSchema}
>
  <PostSingle post={post} />
</Base>
