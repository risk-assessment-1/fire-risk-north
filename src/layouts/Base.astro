---
import type { ImageMetadata } from "astro";
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import theme from "@/config/theme.json";
import { getLangFromUrl, stripHtmlExt } from "@/lib/utils/languageParser";
import {
  organizationSchema,
  professionalServiceSchema,
  websiteSchema,
} from "@/lib/schema";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
import {
  GoogleTagmanager,
  GoogleTagmanagerNoscript,
} from "@digi4care/astro-google-tagmanager";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import SearchModal from "./helpers/SearchModal";

// font families - extract font names for Font component (filter out type keys)
const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);
export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string | ImageMetadata;
  image_alt?: string;
  noindex?: boolean;
  canonical?: string;
  lang?: string;
  schema?: object | object[];
  disableRating?: boolean;
}
// distructure frontmatters
const {
  title,
  meta_title,
  description,
  image,
  image_alt,
  noindex,
  canonical,
  lang,
  schema,
  disableRating,
} = Astro.props;

const imageSrc = typeof image === "object" ? image.src : image;
const language = lang || getLangFromUrl(Astro.url);
const canonicalUrl =
  canonical ||
  `${config.site.base_url}${stripHtmlExt(Astro.url.pathname) === "/" ? "" : stripHtmlExt(Astro.url.pathname)}`;

// JSON-LD: WebSite everywhere, Organization on the homepage only,
// ProfessionalService rating everywhere except pages that opt out
// (location pages carry their own local targeting).
const isHomepage = stripHtmlExt(Astro.url.pathname) === "/";
const extraSchemas = Array.isArray(schema) ? schema : schema ? [schema] : [];
const schemas: object[] = [
  websiteSchema,
  ...(isHomepage ? [organizationSchema] : []),
  ...(!disableRating ? [professionalServiceSchema] : []),
  ...extraSchemas,
];
---

<!doctype html>
<html lang={language}>
  <head>
    <!-- google tag manager -->
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanager id={config.google_tag_manager.gtm_id} />
      )
    }

    <!-- favicon -->
    <link rel="shortcut icon" href={config.site.favicon} />
    <!-- theme meta -->
    <meta name="theme-name" content="bexer-astro" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000"
    />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- google font css - Astro 6 built-in Font API -->
    {
      fontEntries.map(([key]) => {
        const cssVar = `--font-${key}` as any;
        return <Font cssVariable={cssVar} preload />;
      })
    }

    <!-- responsive meta -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <!-- title -->
    <title>
      {plainify(meta_title ? meta_title : title ? title : config.site.title)}
    </title>

    <!-- canonical url -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- noindex robots -->
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- meta-description -->
    <meta
      name="description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />

    <ClientRouter />

    <!-- author from config.json -->
    <meta name="author" content={config.metadata.meta_author} />

    <!-- og-title -->
    <meta
      property="og:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />

    <!-- og-description -->
    <meta
      property="og:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />

    <!-- twitter-title -->
    <meta
      name="twitter:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />

    <!-- twitter-description -->
    <meta
      name="twitter:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />

    <!-- og-image -->
    <meta
      property="og:image"
      content={`${config.site.base_url}${
        imageSrc ? imageSrc : config.metadata.meta_image
      }`}
    />

    <!-- twitter-image -->
    <meta
      name="twitter:image"
      content={`${config.site.base_url}${
        imageSrc ? imageSrc : config.metadata.meta_image
      }`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:site_name" content={config.site.title} />
    <meta property="og:locale" content={config.metadata.og_locale} />
    <meta
      property="og:image:alt"
      content={image_alt ||
        plainify(meta_title ? meta_title : title ? title : config.site.title)}
    />
    <meta name="twitter:site" content={config.metadata.twitter_site} />
    <meta name="twitter:creator" content={config.metadata.twitter_creator} />
    <meta
      name="twitter:image:alt"
      content={image_alt ||
        plainify(meta_title ? meta_title : title ? title : config.site.title)}
    />

    {
      schemas.map((schema) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(schema)}
        />
      ))
    }
  </head>
  <body class="overflow-x-hidden leading-5.5 relative">
    {/* google tag manager noscript */}
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanagerNoscript id={config.google_tag_manager.gtm_id} />
      )
    }

    <TwSizeIndicator />
    <Header />
    <SearchModal lang={language} client:idle />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
