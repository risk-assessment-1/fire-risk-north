---
import { buildBreadcrumbSchema, getBreadcrumbParts } from "@/lib/breadcrumbs";
import config from "@/config/config.json";
import { getLangFromUrl } from "@/lib/utils/languageParser";

const { className, current }: { className?: string; current?: string } =
  Astro.props;

const parts = getBreadcrumbParts(Astro.url.pathname, getLangFromUrl(Astro.url));
if (current && parts.length > 1) parts[parts.length - 1].label = current.trim();

const breadcrumbSchema = buildBreadcrumbSchema(parts, config.site.base_url);
---

<nav aria-label="Breadcrumb" class={className}>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />
  <ol class="inline-flex">
    {
      parts.map(({ label, ...attrs }, index) => (
        <li class="mx-1 capitalize">
          {index > 0 && <span class="inline-block mr-1">/</span>}
          {index !== parts.length - 1 ? (
            <a
              class="text-primary-on-dark dark:text-darkmode-primary"
              {...attrs}
            >
              {label}
            </a>
          ) : (
            <span class="text-light dark:text-darkmode-text">{label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
