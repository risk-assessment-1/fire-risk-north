---
import { getLangFromUrl, slugSelector } from "@/lib/utils/languageParser";
import { markdownify } from "@/lib/utils/textConverter";

const { process } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<section class="section pt-0">
  <div class="container">
    <div class="row justify-center">
      <div class="lg:col-8 md:col-10 text-center">
        <div class="section-title">
          <span class="section-title-border mx-auto"></span>
          <h2 class="mx-auto!" set:html={markdownify(process.title)} />
        </div>
        {
          process.description && (
            <p
              class="text-balance"
              set:html={markdownify(process.description)}
            />
          )
        }
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">
      {
        process.steps.map(
          (step: { name: string; content: string }, i: number) => (
            <div class="box-shadow">
              <div class="p-6 bg-white dark:bg-darkmode-light">
                <div class="icon-bg water-wave flex items-center justify-center mb-6">
                  <span class="h4 text-white dark:text-darkmode-text-dark font-bold">
                    {i + 1}
                  </span>
                </div>
                <h3 class="heading h5 mb-2" set:html={markdownify(step.name)} />
                <p class="text-balance" set:html={markdownify(step.content)} />
              </div>
            </div>
          ),
        )
      }
    </div>

    <div class="mt-10 text-center">
      <a
        href={slugSelector("/contact", lang)}
        class="btn btn-primary hover-ripple"
      >
        Get Your Quote
      </a>
    </div>
  </div>
</section>
